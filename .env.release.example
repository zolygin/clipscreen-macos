# Copy to .env.release.local and configure ONE notarization method.
# Existing Keychain profile (recommended if already configured):
# APPLE_KEYCHAIN_PROFILE=Clipscreen Notary

# Or the same Apple ID variables supported by Dictata/electron-builder:
# APPLE_ID=developer@example.com
# APPLE_TEAM_ID=YOURTEAMID
# APPLE_APP_SPECIFIC_PASSWORD=your-app-specific-password
# APPLE_ID_PASSWORD is accepted as a compatibility alias.

# Optional when several valid Developer ID Application identities exist:
# CLIPSCREEN_SIGNING_IDENTITY=Developer ID Application: Your Name (YOURTEAMID)

# Bundle identity defaults to Resources/Info.plist for compatibility.
# Set this only for a deliberate identity migration:
# CLIPSCREEN_BUNDLE_ID=com.example.clipscreen
